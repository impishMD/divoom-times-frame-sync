DIVOOM_HOST=192.168.1.100
DIVOOM_PORT=9000
DIVOOM_TOKEN=
# Exact name of an existing ordinary album in Divoom:
DIVOOM_ALBUM=Photos
# Optional Divoom sender ID; 0 means a local sender.
DIVOOM_USER_ID=0
DATA_DIR=./data
SYNC_INTERVAL=300
# mirror removes missing managed items from the album; append only adds.
SYNC_MODE=mirror
IMAGE_FIT=contain

# Sync every album declared in this TOML file.
# Copy sources.example.toml to sources.toml before enabling.
SOURCES_FILE=./sources.toml
GOOGLE_PHOTOS_SHARE_URL=
ICLOUD_SHARE_URL=
IMMICH_SHARE_URL=
IMMICH_SHARE_PASSWORD=
ONEDRIVE_SHARE_URL=
YANDEX_DISK_SHARE_URL=
